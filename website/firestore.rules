rules_version = '2';

// 肉球派對 Firestore 資料庫規則
// 發布方式：複製整份內容，貼到 Firebase 主控台 → Firestore Database → 規則 → 發布
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== 共用檢查 =====

    // 管理員（老闆）：用 Firebase UID 判斷，不用 Email
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "wIP0UJxPk7MBO0bxBDq7o9ngbWc2";
    }

    // 金額：整數或空白（null）
    function isPriceOrNull(value) {
      return value == null || (value is int && value >= 0);
    }

    function isTextOrNull(value) {
      return value == null || value is string;
    }

    // 文字長度在 min～max 之間
    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    // 欄位剛好是這些（不能多、不能少）
    function hasExactKeys(data, keys) {
      return data.keys().hasAll(keys) && data.keys().hasOnly(keys);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // 這份資料的 uid 是不是登入者自己
    function isOwner(uid) {
      return isSignedIn() && uid == request.auth.uid;
    }

    // 手機：09 開頭 10 碼
    function isPhone(value) {
      return value is string && value.matches('^09[0-9]{8}$');
    }

    // ===== 商品 products =====

    function isValidProduct(data) {
      return data.keys().hasOnly([
          'name', 'english', 'category', 'tagline', 'description', 'emoji',
          'label', 'price', 'originalPrice', 'published', 'sortOrder',
          'image', 'videoUrl', 'model3DUrl'
        ])
        && data.name is string && data.name.size() > 0
        && data.english is string
        && data.category is string
        && data.tagline is string
        && data.description is string
        && data.emoji is string
        && data.label is string
        && isPriceOrNull(data.price)
        && isPriceOrNull(data.originalPrice)
        && data.published is bool
        && data.sortOrder is int
        && isTextOrNull(data.image)
        && isTextOrNull(data.videoUrl)
        && isTextOrNull(data.model3DUrl);
    }

    // 商品：所有人可讀；只有管理員能新增、修改、刪除
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProduct(request.resource.data);
      allow delete: if isAdmin();
    }

    // ===== 訂單 orders（完整資料，含個資）=====

    // 客人新增訂單的格式檢查
    // 必須和 orderStatus/{同一個 ID} 在同一批次一起寫入，且編號、金額一致
    function isValidNewOrder(orderId) {
      let d = request.resource.data;
      let pub = getAfter(/databases/$(database)/documents/orderStatus/$(orderId)).data;
      return hasExactKeys(d, [
          'orderNo', 'uid', 'name', 'phone', 'shipping', 'note',
          'items', 'total', 'status', 'createdAt'
        ])
        // uid：沒登入是 null；登入者只能填自己的 uid
        && (d.uid == null || (isSignedIn() && d.uid == request.auth.uid))
        && isText(d.orderNo, 1, 20)
        && isText(d.name, 1, 30)
        && d.phone is string && d.phone.matches('^09[0-9]{8}$')
        && isText(d.shipping, 1, 200)
        && isText(d.note, 0, 300)
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 30
        && d.total is int && d.total > 0 && d.total <= 1000000
        && d.status == 'pending'
        && d.createdAt == request.time
        && pub.orderNo == d.orderNo
        && pub.total == d.total;
    }

    // 任何人都能新增；會員只能讀 uid 等於自己的訂單；不能改、不能刪
    // 管理員全部可以讀、改；刪除只限「已取消」的訂單
    match /orders/{orderId} {
      allow create: if isAdmin() || isValidNewOrder(orderId);
      allow read: if isAdmin() || isOwner(resource.data.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin() && resource.data.status == 'cancelled';
    }

    // ===== 訂單公開狀態 orderStatus（不含個資）=====

    // 客人新增時的格式檢查：狀態必須是待匯款，物流與匯款欄位必須是空的
    function isValidNewOrderStatus(orderId) {
      let d = request.resource.data;
      return hasExactKeys(d, [
          'orderNo', 'status', 'total', 'items',
          'shippingCarrier', 'trackingNo',
          'remittanceLast5', 'remittanceReportedAt',
          'createdAt', 'updatedAt'
        ])
        && isText(d.orderNo, 1, 20)
        && d.status == 'pending'
        && d.total is int && d.total > 0 && d.total <= 1000000
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 30
        && d.shippingCarrier == null
        && d.trackingNo == null
        && d.remittanceLast5 == null
        && d.remittanceReportedAt == null
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/orders/$(orderId));
    }

    // 客人回報匯款：只能改末五碼與回報時間，且只在「待匯款」時可以
    function isRemittanceReport() {
      return resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['remittanceLast5', 'remittanceReportedAt'])
        && request.resource.data.remittanceLast5 is string
        && request.resource.data.remittanceLast5.matches('^[0-9]{5}$')
        && request.resource.data.remittanceReportedAt == request.time;
    }

    match /orderStatus/{orderId} {
      // 知道訂單 ID 才能單筆讀取；只有管理員能列出全部
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin() || isValidNewOrderStatus(orderId);
      allow update: if isAdmin() || isRemittanceReport();
      // 刪除只限「已取消」（和 orders 一起刪）
      allow delete: if isAdmin() && resource.data.status == 'cancelled';
    }

    // ===== 設定 settings =====

    function isValidPayment(data) {
      return hasExactKeys(data, [
          'bankName', 'bankCode', 'accountNumber', 'accountName', 'note'
        ])
        && isText(data.bankName, 0, 100)
        && isText(data.bankCode, 0, 100)
        && isText(data.accountNumber, 0, 100)
        && isText(data.accountName, 0, 100)
        && isText(data.note, 0, 100);
    }

    // 匯款資訊：所有人可讀；只有管理員能寫
    match /settings/{settingId} {
      allow read: if settingId == 'payment';
      allow create, update: if isAdmin() && settingId == 'payment'
        && isValidPayment(request.resource.data);
      allow delete: if isAdmin();
    }

    // ===== 會員 members/{uid} =====

    // 客人只能建立自己的會員檔，而且只能有 email、createdAt 兩個欄位
    function isValidNewMember(uid) {
      let d = request.resource.data;
      return isOwner(uid)
        && hasExactKeys(d, ['email', 'createdAt'])
        && d.email is string
        && d.email == request.auth.token.email
        && d.createdAt == request.time;
    }

    match /members/{uid} {
      allow get: if isAdmin() || isOwner(uid);
      allow list: if isAdmin();
      allow create: if isAdmin() || isValidNewMember(uid);
      // 修改（例如 adminNote）、刪除只有管理員
      allow update, delete: if isAdmin();
    }

    // ===== 寄倉流水 stockLogs =====
    //
    // 注意：規則算不出餘額（規則無法加總多份文件），
    // 所以「出庫超過餘額」「出貨申請超過餘額」都擋不住，只能靠畫面警告與老闆核對。

    function isValidStockLogFields(d) {
      return hasExactKeys(d, [
          'uid', 'product', 'type', 'quantity', 'note', 'occurredOn',
          'voided', 'voidReason', 'createdAt'
        ])
        && isText(d.uid, 1, 128)
        && isText(d.product, 1, 60)
        && d.type in ['in', 'out']
        && d.quantity is int && d.quantity >= 1 && d.quantity <= 100000
        && isText(d.note, 0, 200)
        && d.occurredOn is string && d.occurredOn.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.voided is bool
        && (d.voidReason == null || isText(d.voidReason, 1, 200))
        && d.createdAt is timestamp;
    }

    // 新增：一定是未作廢，時間是伺服器時間
    function isValidNewStockLog() {
      let d = request.resource.data;
      return isValidStockLogFields(d)
        && d.voided == false
        && d.voidReason == null
        && d.createdAt == request.time;
    }

    // 修改：只能「作廢」（填原因），不能改數量、商品等內容
    function isStockLogVoid() {
      let d = request.resource.data;
      return isValidStockLogFields(d)
        && resource.data.voided == false
        && d.diff(resource.data).affectedKeys().hasOnly(['voided', 'voidReason'])
        && d.voided == true
        && isText(d.voidReason, 1, 200);
    }

    match /stockLogs/{logId} {
      // 客人只能讀自己的（查詢時要用 where('uid', '==', 自己的 uid)）
      allow read: if isAdmin() || isOwner(resource.data.uid);
      allow create: if isAdmin() && isValidNewStockLog();
      allow update: if isAdmin() && isStockLogVoid();
      // 刪除：必須先作廢
      allow delete: if isAdmin() && resource.data.voided == true;
    }

    // ===== 出貨申請 shipRequests =====

    function isValidNewShipRequest() {
      let d = request.resource.data;
      return hasExactKeys(d, [
          'uid', 'items', 'name', 'phone', 'shipping', 'note', 'status',
          'carrier', 'trackingNo', 'adminNote', 'createdAt', 'updatedAt'
        ])
        && isOwner(d.uid)
        && d.items is list && d.items.size() >= 1 && d.items.size() <= 30
        && isText(d.name, 1, 30)
        && isPhone(d.phone)
        && isText(d.shipping, 1, 200)
        && isText(d.note, 0, 300)
        && d.status == 'pending'
        && d.carrier == null
        && d.trackingNo == null
        && d.adminNote == null
        && d.createdAt == request.time
        && d.updatedAt == request.time;
    }

    match /shipRequests/{requestId} {
      // 客人只能讀自己的、只能新增自己的；不能改、不能刪
      allow read: if isAdmin() || isOwner(resource.data.uid);
      allow create: if isAdmin() || isValidNewShipRequest();
      allow update: if isAdmin();
      // 刪除只限「已出貨」或「已取消」
      allow delete: if isAdmin() && resource.data.status in ['done', 'cancelled'];
    }

    // 其他集合：沒有列在上面的，一律不開放（預設全鎖）
  }
}
